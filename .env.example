# Label Studio — https://beta-label.kantham.ai
LABEL_STUDIO_URL=https://beta-label.kantham.ai
LABEL_STUDIO_EMAIL=your-email@example.com
LABEL_STUDIO_PASSWORD=your-password

# Optional: legacy Label Studio API key (non-JWT). On Label Studio 1.23+, the JWT token
# shown under "Personal Access Token" is NOT used directly — email/password login is used.
# LABEL_STUDIO_API_KEY=

# Upload: 0 = keep project + human labels (recommended)
RECREATE_LABEL_PROJECT=0
MAX_UPLOAD_SAMPLES=50

# Semi-supervised pseudo-labeling
MAX_AUTO_SAMPLES=100000
PSEUDO_HIGH=0.55
PSEUDO_LOW=0.45
NOMIC_BATCH_SIZE=64

# Training (Nomic Embed)
TRAIN_EPOCHS=2
MAX_TRAIN_SAMPLES=50000
TRAIN_BATCH_SIZE=16
TRAIN_LOG_EVERY=50

# Push Relevant / Not Relevant pre-annotations to Label Studio
PUSH_PREDICTIONS=1
MAX_PREDICTIONS=2000
